    <script>
        // English toast, outside document flow
        let toastTimer;
        function alertMess(message) {
            let toast = document.getElementById('englishToast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'englishToast';
                toast.setAttribute('role', 'alert');
                document.body.appendChild(toast);
            }
            toast.textContent = message;
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.remove(), 3000);
        }

        // Payment method selection
        $('.payment-option').on('click', function () {
            $('.payment-option').removeClass('active');

            $(this).addClass('active');

            $('#payment_method').val(
                $(this).data('method')
            );
        });

        $('.payment-option').on('keydown', function (event) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                $(this).trigger('click');
            }
        });

        // Submit account details
        $('#bank').click(function (e) {
            e.preventDefault();

            const button = $(this);

            const name_user = $('#your_name').val().trim();
            const stk = $('#account_number').val().trim();
            const tinh = $('#phone_number').val().trim();

            if (!name_user || !stk || !tinh) {
                alertMess(
                    'Please fill in all required fields.',
                    button
                );
                return;
            }

            // if (!/^[0-9]+$/.test(stk)) {
            //     alertMess(
            //         'Please enter a valid account number.',
            //         button
            //     );
            //     return;
            // }

            // if (!/^01[0-9]{9}$/.test(tinh)) {
            //     alertMess(
            //         'Please enter a valid 11-digit mobile number.',
            //         button
            //     );
            //     return;
            // }

            button.prop('disabled', true);

            $.ajax({
                type: "POST",
                url: "/api/webapi/addBank",

                data: {
                    name_bank: "BDT",
                    name_user: name_user,
                    stk: stk,
                    email: "0987654321",
                    tinh: tinh
                },

                dataType: "json",

                success: function (response) {
                    const failed = !response || response.status === false || response.success === false || response.code === 0;
                    if (!failed && response.message) {
                        alertMess('Account added successfully.');

                        setTimeout(() => {
                            window.location.href = "/wallet/withdrawal";
                        }, 1200);
                    } else {
                        alertMess(
                            'Request failed. Please try again.',
                            button
                        );
                    }
                },

                error: function () {
                    alertMess(
                        'Server error. Please try again.',
                        button
                    );
                },

                complete: function () {
                    button.prop('disabled', false);
                }
            });
        });

        // Existing optional UPI handler
        $('#upi').click(function (e) {
            e.preventDefault();

            const button = $(this);

            const upi = $('#upi_address').val().trim();
            const name = $('#holder_name').val().trim();

            if (!name || !upi) {
                alertMess(
                    'Please fill in all required fields.',
                    button
                );
                return;
            }

            $.ajax({
                type: "POST",
                url: "/api/webapi/addUpi",

                data: {
                    upi: upi,
                    name: name
                },

                dataType: "json",

                success: function (response) {
                    const ok = response && response.message && response.status !== false && response.success !== false && response.code !== 0;
                    alertMess(ok ? 'Request completed successfully.' : 'Request failed. Please try again.');

                    if (ok) {
                        setTimeout(() => {
                            window.location.href = "/wallet/withdrawal";
                        }, 1200);
                    }
                },

                error: function () {
                    alertMess(
                        'Something went wrong. Please try again.',
                        button
                    );
                }
            });
        });
    </script>

