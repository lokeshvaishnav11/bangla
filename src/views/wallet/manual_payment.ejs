
<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>পেমেন্ট পদ্ধতি নির্বাচন করুন</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    />

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.7/axios.min.js"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: linear-gradient(155deg, #f8fbff, #e5eefb);
            font-family: 'Hind Siliguri', sans-serif;
            color: #111b33;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px 12px;
        }

        .panel {
            width: 100%;
            max-width: 460px;
            background: #fff;
            border-radius: 24px;
            padding: 28px 17px 23px;
            box-shadow: 0 15px 40px #253c6510;
        }

        .heading {
            text-align: center;
            font-size: 25px;
            font-weight: 700;
            line-height: 1.3;
        }

        .subtitle {
            text-align: center;
            color: #79869a;
            font-size: 15px;
            margin: 9px 0 27px;
        }

        .section-label {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #748299;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.3px;
            justify-content: center;
            margin-bottom: 19px;
        }

        .section-label:before,
        .section-label:after {
            content: '';
            height: 1px;
            background: #dce1e9;
            flex: 1;
        }

        .methods {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .method {
            position: relative;
            border: 2px solid;
            border-radius: 17px;
            min-height: 325px;
            padding: 18px 10px 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            cursor: pointer;
            transition: transform .2s, box-shadow .2s;
        }

        .method:focus-visible {
            outline: 3px solid #536caa;
            outline-offset: 3px;
        }

        .method.bkash {
            border-color: #ed008c;
            background: linear-gradient(155deg, #ffedf7, #fff 65%);
        }

        .method.nagad {
            border-color: #f43b16;
            background: linear-gradient(155deg, #fff0e4, #fff 65%);
        }

        .method.selected {
            box-shadow: 0 8px 20px #172b4c16;
        }

        .method:hover {
            transform: translateY(-2px);
        }

        .radio {
            position: absolute;
            right: 13px;
            top: 14px;
            width: 22px;
            height: 22px;
            border: 1.5px solid #9a9a9a;
            border-radius: 50%;
            background: white;
        }

        .selected .radio {
            border-color: #ec008c;
        }

        .selected .radio:after {
            content: '';
            position: absolute;
            inset: 4px;
            background: #ed008c;
            border-radius: 50%;
        }

        .nagad.selected .radio {
            border-color: #f43b16;
        }

        .nagad.selected .radio:after {
            background: #f43b16;
        }

        .brand {
            height: 135px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 8px;
        }

        .bkash-name {
            font-family: Arial, sans-serif;
            font-size: 29px;
            letter-spacing: -1.5px;
            color: #181d30;
        }

        .bkash-name b {
            color: #e90081;
            font-weight: 700;
        }

        .bkash-mark {
            width: 64px;
            height: 64px;
        }

        .nagad-mark {
            width: 65px;
            height: 65px;
        }

        .nagad-name {
            font-size: 25px;
            font-weight: 700;
            color: #f02d16;
            white-space: nowrap;
        }

        .nagad-name small {
            font: 700 21px Arial, sans-serif;
            color: #1a1c2b;
        }

        .tagline {
            font-size: 12px;
            color: #7b889a;
            line-height: 1.5;
            min-height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 5px 0 14px;
        }

        .pay {
            border: 0;
            border-radius: 12px;
            color: #fff;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            min-height: 55px;
            width: 100%;
            margin-top: auto;
            cursor: pointer;
            box-shadow: 0 7px 0 #a80058;
            background: linear-gradient(120deg, #f00087, #ff0099);
            transition: transform .15s, box-shadow .15s;
        }

        .pay:active {
            transform: translateY(4px);
            box-shadow: 0 3px 0 #a80058;
        }

        .nagad .pay {
            background: linear-gradient(120deg, #ff633e, #ff260b);
            box-shadow: 0 7px 0 #bd1c06;
        }

        .nagad .pay:active {
            box-shadow: 0 3px 0 #bd1c06;
        }

        .pay:disabled {
            opacity: .6;
            cursor: wait;
        }

        .amount-label {
            display: block;
            color: #718098;
            font-size: 17px;
            margin: 27px 0 9px;
        }

        .amount-box {
            display: flex;
            align-items: center;
            gap: 14px;
            border: 1px solid #dce2ea;
            border-radius: 14px;
            padding: 15px 20px;
            font-size: 29px;
            min-height: 72px;
        }

        .amount-box span {
            color: #78879f;
        }

        .amount-box strong {
            font-weight: 500;
            overflow-wrap: anywhere;
        }

        .secure {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            color: #7a8799;
            font-size: 15px;
            margin-top: 23px;
        }

        .secure i {
            color: #71819a;
        }

        .toast {
            position: fixed;
            left: 50%;
            top: 18px;
            transform: translateX(-50%);
            background: #15233b;
            color: #fff;
            padding: 12px 20px;
            border-radius: 12px;
            box-shadow: 0 8px 25px #0002;
            z-index: 10;
            max-width: 90%;
            text-align: center;
        }

        @media (max-width: 360px) {
            .panel {
                padding: 24px 12px;
            }

            .heading {
                font-size: 22px;
            }

            .methods {
                gap: 9px;
            }

            .method {
                padding: 15px 7px 12px;
                min-height: 310px;
            }

            .nagad-name {
                font-size: 21px;
            }

            .nagad-name small {
                font-size: 17px;
            }

            .pay {
                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <main class="panel">

        <h1 class="heading">
            পেমেন্ট পদ্ধতি নির্বাচন করুন
        </h1>

        <p class="subtitle">
            আপনার পছন্দের পেমেন্ট মাধ্যম বেছে নিন
        </p>

        <div class="section-label">
            পেমেন্ট গেটওয়ে
        </div>

        <div
            class="methods"
            role="group"
            aria-label="পেমেন্ট মাধ্যম"
        >

            <!-- BKASH -->

            <section
                class="method bkash selected"
                id="bkashCard"
                tabindex="0"
                role="radio"
                aria-checked="true"
                aria-label="বিকাশ"
            >

                <span class="radio" aria-hidden="true"></span>

                <div class="brand">

                    <div class="bkash-name">
                        <b>b</b>Kash
                    </div>

                    <svg
                        class="bkash-mark"
                        viewBox="0 0 90 90"
                        aria-hidden="true"
                    >
                        <path
                            fill="#ed008c"
                            d="M9 10 66 22 48 45 9 10ZM10 15 48 48 33 76 10 15ZM51 48 72 35 81 47 51 48ZM48 51 67 54 35 79 48 51Z"
                        />
                        <path
                            fill="#f94bac"
                            d="m13 10 53 12-17 22z"
                        />
                    </svg>

                </div>

                <p class="tagline">
                    দ্রুত, নিরাপদ ও সহজ পেমেন্ট
                </p>

                <button
                    class="pay"
                    id="upi1"
                    type="button"
                >
                    বিকাশ দিয়ে পেমেন্ট করুন
                    &nbsp;
                    <i class="fa-solid fa-arrow-right"></i>
                </button>

            </section>

            <!-- NAGAD -->

            <section
                class="method nagad"
                id="nagadCard"
                tabindex="0"
                role="radio"
                aria-checked="false"
                aria-label="নগদ"
            >

                <span class="radio" aria-hidden="true"></span>

                <div class="brand">

                    <svg
                        class="nagad-mark"
                        viewBox="0 0 80 80"
                        aria-hidden="true"
                    >
                        <defs>
                            <linearGradient
                                id="ng"
                                x1="0"
                                y1="0"
                                x2="1"
                                y2="1"
                            >
                                <stop stop-color="#ffae00" />
                                <stop
                                    offset="1"
                                    stop-color="#f22c08"
                                />
                            </linearGradient>
                        </defs>

                        <circle
                            cx="40"
                            cy="40"
                            r="34"
                            fill="url(#ng)"
                        />

                        <circle
                            cx="40"
                            cy="40"
                            r="20"
                            fill="#fff"
                        />

                        <path
                            d="M28 45 40 29 52 35 41 51 33 47 40 38"
                            fill="none"
                            stroke="#f34316"
                            stroke-width="5"
                            stroke-linejoin="round"
                        />

                        <path
                            d="m45 5-3 17M64 16 53 28M73 36 57 38"
                            stroke="#fff"
                            stroke-width="3"
                        />
                    </svg>

                    <div class="nagad-name">
                        নগদ <small>Nagad</small>
                    </div>

                </div>

                <p class="tagline">
                    বাংলাদেশের সহজ ডিজিটাল লেনদেন
                </p>

                <button
                    class="pay"
                    id="upi3"
                    type="button"
                >
                    নগদ দিয়ে পেমেন্ট করুন
                    &nbsp;
                    <i class="fa-solid fa-arrow-right"></i>
                </button>

            </section>

        </div>

        <!-- AMOUNT -->

        <label class="amount-label">
            টাকার পরিমাণ (BDT)
        </label>

        <div class="amount-box">
            <span>৳</span>
            <strong id="amountText"><%= Amount %></strong>
        </div>

        <div class="secure">
            <i class="fa-solid fa-lock"></i>
            নিরাপদ পেমেন্ট
        </div>

    </main>

    <script>
        // ===================================
        // PAYMENT AMOUNT
        // ===================================

        const amount = '<%= Amount %>';

        // ===================================
        // PAYMENT CARDS
        // ===================================

        const cards = {
            bkash: document.getElementById('bkashCard'),
            nagad: document.getElementById('nagadCard')
        };

        let selected = 'bkash';

        function choose(method) {
            selected = method;

            Object.entries(cards).forEach(([name, el]) => {
                const active = name === method;

                el.classList.toggle('selected', active);

                el.setAttribute(
                    'aria-checked',
                    String(active)
                );
            });
        }

        Object.entries(cards).forEach(([name, el]) => {

            el.addEventListener('click', e => {
                if (e.target.closest('button')) return;

                choose(name);
            });

            el.addEventListener('keydown', e => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    choose(name);
                }
            });

        });

        // ===================================
        // ENGLISH NOTIFICATIONS
        // ===================================

        function notify(message) {
            const old = document.querySelector('.toast');

            if (old) {
                old.remove();
            }

            const el = document.createElement('div');

            el.className = 'toast';
            el.textContent = message;

            document.body.appendChild(el);

            setTimeout(() => {
                el.remove();
            }, 3000);
        }

        // ===================================
        // PAYMENT API
        // ===================================

        let busy = false;

        async function callPaymentApi(url, method) {

            if (busy) return;

            choose(method);

            const money = Number(amount);

            if (!Number.isFinite(money) || money <= 0) {
                notify('Invalid payment amount');
                return;
            }

            busy = true;

            document.querySelectorAll('.pay').forEach(button => {
                button.disabled = true;
            });

            notify('Processing your payment...');

            try {

                const response = await axios.post(url, {
                    money: amount
                });

                const data = response?.data;

                if (!data || data.status === false) {
                    notify('Payment request failed');
                    return;
                }

                const target = data.paymentUrl || data.url;

                if (target) {

                    const parsed = new URL(
                        target,
                        location.origin
                    );

                    if (
                        !['http:', 'https:'].includes(parsed.protocol)
                    ) {
                        throw new Error('Invalid payment URL');
                    }

                    window.location.href = parsed.href;
                    return;
                }

                notify('Payment link not found');

            } catch (error) {

                console.error(
                    'Payment request failed',
                    error
                );

                notify(
                    'Unable to start payment. Please try again.'
                );

            } finally {

                busy = false;

                document.querySelectorAll('.pay').forEach(button => {
                    button.disabled = false;
                });
            }
        }

        // ===================================
        // BKASH PAYMENT
        // ===================================

        document.getElementById('upi1').addEventListener(
            'click',
            () => callPaymentApi(
                '/wallet/paynow/manual_upi_request',
                'bkash'
            )
        );

        // ===================================
        // NAGAD PAYMENT
        // ===================================

        document.getElementById('upi3').addEventListener(
            'click',
            () => callPaymentApi(
                '/wallet/paynow/watch_now',
                'nagad'
            )
        );

    </script>

</body>
</html>
